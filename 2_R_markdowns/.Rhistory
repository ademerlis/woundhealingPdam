),
# Legend settings - position at top
heatmap_legend_param = list(
title = "Expression",
direction = "horizontal",
legend_width = unit(6, "cm")
),
# Other settings
border = TRUE
)
# Draw the heatmap with legends on top
draw(ht,
heatmap_legend_side = "top",
annotation_legend_side = "top",
merge_legend = TRUE,
padding = unit(c(2, 2, 10, 2), "mm")  # top, right, bottom, left
)
pdf("heatmap_injury_degs.pdf", width = 14, height = 12)
draw(ht, heatmap_legend_side = "top", annotation_legend_side = "top", merge_legend = TRUE)
