pdf("heatmap_injury_degs_hour_condition.pdf", width = plot_width, height = plot_height)
# 1. Generate the heatmap but save it as an object without plotting it immediately
ph<-pheatmap(
mat_ordered,
annotation_col = col_annotation_ordered,
annotation_colors = ann_colors,
cluster_rows = TRUE,
cluster_cols = FALSE,
clustering_distance_rows = "euclidean",
clustering_method = "complete",
show_colnames = TRUE,
show_rownames = TRUE,
fontsize_row = 10,
fontsize_col = 10,
color = colorRampPalette(rev(brewer.pal(n = 7, name = "RdBu")))(100),
breaks = seq(-2, 2, length.out = 101),
cellwidth = 12,
cellheight = 8
)
# 2. Draw the heatmap and specify the legend position ("bottom", "top", "left", or "right")
draw(ph, heatmap_legend_side = "top", annotation_legend_side = "top")
dev.off()
library(tidyverse)
