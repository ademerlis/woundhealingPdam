Condition = col_annotation$Condition,
Hour = col_annotation$Hour,
col = list(
Condition = condition_colors,
Hour = hour_colors
),
annotation_legend_param = list(
Condition = list(title = "Condition", direction = "horizontal"),
Hour = list(title = "Hour", direction = "horizontal")
),
show_annotation_name = TRUE,
annotation_name_side = "left"
)
# Create annotation dataframe for columns
# Extract condition and hour from your metadata
col_annotation <- data.frame(
Condition = metadata$condition,  # adjust column name if needed
Hour = factor(metadata$hour),    # adjust column name if needed
row.names = colnames(mat)
)
# Define colors for annotations
condition_colors <- c(wounded = "#E41A1C", control = "#377EB8")
hour_colors <- setNames(
brewer.pal(length(unique(metadata$hour)), "Set2"),
levels(factor(metadata$hour))
)
# Define colors for annotations
condition_colors <- c(Wounded = "#E41A1C", Control = "#377EB8")
# Create column annotations with legends on top
col_ha <- HeatmapAnnotation(
Condition = col_annotation$Condition,
Hour = col_annotation$Hour,
col = list(
Condition = condition_colors,
Hour = hour_colors
),
annotation_legend_param = list(
Condition = list(title = "Condition", direction = "horizontal"),
Hour = list(title = "Hour", direction = "horizontal")
),
show_annotation_name = TRUE,
annotation_name_side = "left"
)
# Create the heatmap
ht <- Heatmap(
mat_scaled,
name = "Z-score",
# Column settings
top_annotation = col_ha,
cluster_columns = TRUE,
clustering_distance_columns = "euclidean",
clustering_method_columns = "complete",
column_names_gp = gpar(fontsize = 8),
show_column_names = TRUE,
column_dend_height = unit(2, "cm"),
# Row settings
cluster_rows = TRUE,
row_names_gp = gpar(fontsize = 7),
show_row_names = TRUE,
row_dend_width = unit(2, "cm"),
# Colors
col = colorRamp2(
seq(-2, 2, length.out = 100),
colorRampPalette(rev(brewer.pal(n = 7, name = "RdBu")))(100)
),
# Legend settings - position at top
heatmap_legend_param = list(
title = "Expression",
direction = "horizontal",
legend_width = unit(6, "cm")
),
# Other settings
border = TRUE,
column_title = "Top 50 DEGs by Variance: Wounded vs Control",
column_title_gp = gpar(fontsize = 12, fontface = "bold")
)
