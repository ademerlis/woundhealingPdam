gene <- clusters$df$genes[i]
in_1h <- gene %in% sig_w_1v0_injury
in_2h <- gene %in% sig_w_2v0_injury
in_4h <- gene %in% sig_w_4v0_injury
if (in_1h & in_2h & in_4h) {
clusters$df$intersection_group[i] <- "All time points"
} else if (in_1h & in_2h & !in_4h) {
clusters$df$intersection_group[i] <- "Wounded 1h and Wounded 2h"
} else if (in_1h & !in_2h & in_4h) {
clusters$df$intersection_group[i] <- "Wounded 1h and Wounded 4h"
} else if (!in_1h & in_2h & in_4h) {
clusters$df$intersection_group[i] <- "Wounded 2h and Wounded 4h"
} else if (in_1h & !in_2h & !in_4h) {
clusters$df$intersection_group[i] <- "Wounded 1h"
} else if (!in_1h & in_2h & !in_4h) {
clusters$df$intersection_group[i] <- "Wounded 2h"
} else if (!in_1h & !in_2h & in_4h) {
clusters$df$intersection_group[i] <- "Wounded 4h"
}
}
