annotation_legend_side = "top",
merge_legend = TRUE,
padding = unit(c(2, 2, 10, 2), "mm")  # top, right, bottom, left
)
col_order <- order(col_annotation$Condition, col_annotation$Hour)
mat_scaled_ordered <- mat_scaled[, col_order]
col_annotation_ordered <- col_annotation[col_order, ]
# Update column annotation with ordered data
col_ha <- HeatmapAnnotation(
