# Only label intersections with ≥ 5 genes
comb_labels <- ifelse(
comb_counts >= 5,
paste0(comb_counts, "\n(", comb_perc, "%)"),
""
)
up <- UpSet(
m,
comb_order = order(comb_counts, decreasing = TRUE),
top_annotation = HeatmapAnnotation(
"Intersection Size" = anno_barplot(
comb_counts,
border = FALSE,
gp = gpar(fill = "black"),
height = unit(4, "cm"),
annotation_label = comb_labels,
annotation_label_gp = gpar(fontsize = 8),
annotation_label_offset = unit(2, "mm")
),
annotation_name_side = "left"
),
right_annotation = rowAnnotation(
"Set Size" = anno_barplot(
set_size(m),
border = FALSE,
gp = gpar(fill = "darkblue"),
width = unit(4, "cm")
)
),
column_title = "Injury-Responsive Genes"
)
# Function to get all possible intersections
get_all_intersections <- function(gene_lists) {
n_sets <- length(gene_lists)
set_names <- names(gene_lists)
results <- list()
# Generate all possible combinations
for (size in 1:n_sets) {
combos <- combn(set_names, size, simplify = FALSE)
for (combo in combos) {
# Get intersection of sets in combo
genes_in <- Reduce(intersect, gene_lists[combo])
# Remove genes in sets not in combo
if (size < n_sets) {
sets_not_in <- setdiff(set_names, combo)
genes_not_in <- unique(unlist(gene_lists[sets_not_in]))
genes_in <- setdiff(genes_in, genes_not_in)
}
if (length(genes_in) > 0) {
combo_name <- paste(combo, collapse = " ∩ ")
results[[combo_name]] <- genes_in
}
}
}
return(results)
}
# Get all intersections
all_intersections <- get_all_intersections(sig_genes_list)
all_intersections$`Wounded_1h vs Wounded_0h ∩ Wounded_4h vs Wounded_0h`
